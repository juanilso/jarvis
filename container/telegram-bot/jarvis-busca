#!/usr/bin/env python3
"""Busca na internet para o Claude/Jarvis quando a ferramenta WebSearch não estiver disponível (ex.: gateway).

Uso:
  jarvis-busca "termos da busca"        -> até 8 resultados (título, link, resumo)
  jarvis-busca --ler https://site/pagina -> texto principal da página (até ~12 mil caracteres)

Usa a API do Brave Search se BRAVE_API_KEY estiver definida; senão, o DuckDuckGo (versão HTML, sem chave).
"""
import html
import json
import os
import re
import sys
import urllib.parse
import urllib.request

UA = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124 Safari/537.36"


def baixar(url, headers=None, timeout=25):
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept-Language": "pt-BR,pt;q=0.9,en;q=0.8",
                                               **(headers or {})})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode(r.headers.get_content_charset() or "utf-8", "replace")


def limpar(t):
    return html.unescape(re.sub(r"<[^>]+>", "", t or "")).strip()


def brave(q, chave):
    url = "https://api.search.brave.com/res/v1/web/search?" + urllib.parse.urlencode({"q": q, "count": 8})
    dados = json.loads(baixar(url, {"Accept": "application/json", "X-Subscription-Token": chave}))
    return [(r.get("title", ""), r.get("url", ""), limpar(r.get("description", ""))) for r in dados.get("web", {}).get("results", [])]


def duckduckgo(q):
    pagina = baixar("https://html.duckduckgo.com/html/?" + urllib.parse.urlencode({"q": q, "kl": "br-pt"}))
    res = []
    for m in re.finditer(r'<a[^>]+class="result__a"[^>]+href="([^"]+)"[^>]*>(.*?)</a>(.*?)(?=<a[^>]+class="result__a"|$)',
                         pagina, re.S):
        link = html.unescape(m.group(1))
        if "uddg=" in link:
            link = urllib.parse.unquote(urllib.parse.parse_qs(urllib.parse.urlparse(link).query).get("uddg", [link])[0])
        trecho = re.search(r'class="result__snippet"[^>]*>(.*?)</a>', m.group(3), re.S)
        res.append((limpar(m.group(2)), link, limpar(trecho.group(1)) if trecho else ""))
        if len(res) >= 8:
            break
    return res


def ler(url):
    pagina = baixar(url)
    pagina = re.sub(r"(?is)<(script|style|noscript|svg|nav|footer|header|form)[^>]*>.*?</\1>", " ", pagina)
    titulo = re.search(r"(?is)<title[^>]*>(.*?)</title>", pagina)
    texto = re.sub(r"(?i)<br\s*/?>|</(p|div|li|h\d|tr)>", "\n", pagina)
    texto = limpar(texto)
    texto = re.sub(r"[ \t]+", " ", texto)
    texto = re.sub(r"\n\s*\n+", "\n\n", texto).strip()
    return (f"# {limpar(titulo.group(1))}\n{url}\n\n" if titulo else f"{url}\n\n") + texto[:12000]


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return 1
    try:
        if sys.argv[1] == "--ler":
            print(ler(sys.argv[2]))
            return 0
        q = " ".join(sys.argv[1:])
        chave = os.environ.get("BRAVE_API_KEY", "").strip()
        res = brave(q, chave) if chave else duckduckgo(q)
        if not res:
            print("Nenhum resultado.")
            return 1
        for i, (t, u, d) in enumerate(res, 1):
            print(f"{i}. {t}\n   {u}\n   {d}\n")
        return 0
    except Exception as e:  # noqa: BLE001
        print(f"Erro na busca: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
