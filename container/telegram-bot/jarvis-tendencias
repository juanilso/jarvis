#!/usr/bin/env python3
"""O que as pessoas estão falando sobre um tema nos últimos 30 dias (Reddit, Hacker News, GitHub, Polymarket…).

Usa o motor da skill last30days (MIT, github.com/mvanhorn/last30days-skill) num ambiente LIMPO:
sem nenhuma chave de API (nem a do gateway), sem cookies do navegador, sem publicar nada e sem instalar extras.

Uso:
  jarvis-tendencias "gateway pix"                       -> relatório com as fontes ordenadas por engajamento
  jarvis-tendencias "painel iptv revenda" --rapido
  jarvis-tendencias "laravel filament" --fontes reddit,github --saida /workspace/.jarvis-conhecimento/tendencias
  jarvis-tendencias --diagnostico                       -> quais fontes estão funcionando

Fontes permitidas: reddit, hackernews, github, polymarket, stocktwits (padrão: reddit,hackernews,github,polymarket).
GitHub com mais limite: defina TENDENCIAS_GITHUB_TOKEN (token SÓ DE LEITURA; o GH_TOKEN do Jarvis nunca é repassado).
"""
import argparse
import os
import subprocess
import sys
import tempfile

MOTOR = os.environ.get("LAST30DAYS_DIR", "/opt/last30days")
PERMITIDAS = ["reddit", "hackernews", "github", "polymarket", "stocktwits"]
PADRAO = "reddit,hackernews,github,polymarket"
SEGURO = (  # configuração fixa do motor: nada de cookies, onboarding, publicação ou contexto antigo
    "SETUP_COMPLETE=true\nFROM_BROWSER=off\nBROWSER_CONSENT=false\nAGENTCOOKIE=off\n"
    "LAST30DAYS_LIBRARY_CONTEXT=off\nLAST30DAYS_REASONING_PROVIDER=auto\n"
)
PASSAR = ("HTTPS_PROXY", "HTTP_PROXY", "NO_PROXY", "https_proxy", "http_proxy", "no_proxy", "SSL_CERT_FILE",
          "REQUESTS_CA_BUNDLE", "TZ")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("tema", nargs="*")
    ap.add_argument("--fontes", default=PADRAO)
    ap.add_argument("--rapido", action="store_true")
    ap.add_argument("--profundo", action="store_true")
    ap.add_argument("--saida", help="pasta onde salvar o relatório bruto (.md)")
    ap.add_argument("--diagnostico", action="store_true")
    ap.add_argument("--simulado", action="store_true", help="dados de teste, sem internet")
    a = ap.parse_args()

    script = os.path.join(MOTOR, "scripts", "last30days.py")
    if not os.path.isfile(script):
        print(f"Motor last30days não encontrado em {MOTOR}. Reconstrua a imagem: docker compose build", file=sys.stderr)
        return 3
    fontes = [f.strip().lower() for f in a.fontes.split(",") if f.strip()]
    proibidas = [f for f in fontes if f not in PERMITIDAS]
    if proibidas:
        print(f"Fonte não permitida: {', '.join(proibidas)}. Use: {', '.join(PERMITIDAS)}", file=sys.stderr)
        return 2
    tema = " ".join(a.tema).strip()
    if not tema and not a.diagnostico:
        print("Diga o tema. Ex.: jarvis-tendencias \"gateway pix\"", file=sys.stderr)
        return 2

    base = os.path.join(os.path.expanduser("~"), ".cache", "jarvis-tendencias")
    config = os.path.join(base, "config")
    os.makedirs(config, exist_ok=True)
    with open(os.path.join(config, ".env"), "w") as f:
        f.write(SEGURO)
    saida = a.saida or os.path.join(base, "saida")
    os.makedirs(saida, exist_ok=True)

    with tempfile.TemporaryDirectory() as casa:  # HOME vazio: o motor não acha credenciais nem navegadores
        env = {"PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": casa, "LANG": "C.UTF-8",
               "LAST30DAYS_CONFIG_DIR": config, "LAST30DAYS_MEMORY_DIR": saida,
               "LAST30DAYS_SKIP_KEYCHAIN": "1", "PYTHONDONTWRITEBYTECODE": "1"}
        env.update({k: os.environ[k] for k in PASSAR if os.environ.get(k)})
        if os.environ.get("TENDENCIAS_GITHUB_TOKEN"):
            env["GITHUB_TOKEN"] = os.environ["TENDENCIAS_GITHUB_TOKEN"]
        cmd = [sys.executable, "-I", script]
        if a.diagnostico:
            cmd += ["--diagnose", "--no-browser-cookies"]
        else:
            cmd += [tema, "--no-browser-cookies", "--search=" + ",".join(fontes), "--save-dir=" + saida, "--emit=md"]
            cmd += ["--quick"] if a.rapido else ["--deep"] if a.profundo else []
            cmd += ["--mock"] if a.simulado else []
        try:
            r = subprocess.run(cmd, env=env, cwd=casa, capture_output=True, text=True, timeout=600)
        except subprocess.TimeoutExpired:
            print("A busca passou de 10 minutos e foi interrompida.", file=sys.stderr)
            return 4
    print(r.stdout)
    if r.returncode != 0:
        print(r.stderr[-1500:], file=sys.stderr)
    return r.returncode


if __name__ == "__main__":
    sys.exit(main())
