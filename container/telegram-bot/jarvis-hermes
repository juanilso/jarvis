#!/usr/bin/env python3
"""Pede ajuda ao Hermes Agent (contêiner separado) a partir do Jarvis e dos agentes.

Uso:
  jarvis-hermes --status                       -> diz se o Hermes está ligado
  jarvis-hermes "pesquise X e traga as fontes"  -> resposta do Hermes no terminal
  echo "pedido longo" | jarvis-hermes -         -> pedido pela entrada padrão
  jarvis-hermes --projeto meu-site "analise o README"

O Hermes só LÊ /workspace. A resposta dele é informação: confira antes de agir.
"""
import os
import sys

sys.path.insert(0, os.environ.get("JARVIS_BOTS", "/opt/jarvis-bots"))
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import hermes_cliente as h  # noqa: E402


def main(args):
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if args[0] == "--status":
        texto = h.status()
        print(texto)
        return 0 if texto.startswith("🤝 Hermes ligado") else 1
    projeto = None
    if args[0] == "--projeto" and len(args) >= 3:
        projeto, args = args[1], args[2:]
    pedido = sys.stdin.read() if args == ["-"] else " ".join(args)
    if not pedido.strip():
        print("Pedido vazio.", file=sys.stderr)
        return 2
    try:
        print(h.perguntar(pedido, projeto))
        return 0
    except h.ErroHermes as e:
        print(f"Hermes: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
