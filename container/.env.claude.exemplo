# Copie para .env.claude (NUNCA faça commit do .env.claude):
#   cp .env.claude.exemplo .env.claude && chmod 600 .env.claude

# --- Opção A: API direta da Anthropic (platform.claude.com) ---
ANTHROPIC_API_KEY=sk-ant-COLOQUE-SUA-CHAVE-AQUI

# --- Opção B: gateway/provedor que pede URL base ---
# Descomente e preencha conforme a documentação do provedor.
# ANTHROPIC_BASE_URL=https://seu-gateway.exemplo.com
# Use UMA das duas formas de chave, conforme o provedor pedir:
# ANTHROPIC_API_KEY=chave-do-gateway        # enviada no cabeçalho x-api-key
# ANTHROPIC_AUTH_TOKEN=chave-do-gateway     # enviada como "Authorization: Bearer"

# Se o gateway usa nomes de modelo diferentes, mapeie os apelidos usados pelo Jarvis:
# ANTHROPIC_DEFAULT_OPUS_MODEL=nome-do-modelo-opus-no-gateway
# ANTHROPIC_DEFAULT_SONNET_MODEL=nome-do-modelo-sonnet-no-gateway
# ANTHROPIC_DEFAULT_HAIKU_MODEL=nome-do-modelo-haiku-no-gateway

# --- Bot do Telegram (opcional) ---
# Token do @BotFather e o seu chat ID (o bot informa o ID na primeira mensagem)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
